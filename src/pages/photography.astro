---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

// Load asset photos with metadata for Astro Image optimization
const assetPhotoModules = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/photos/*.{jpg,jpeg,png,webp,avif}",
	{ eager: true },
);

function extractDateFromPath(path: string): number {
	const base = path.split("/").pop() || "";
	const match = base.match(/(\d{4})-(\d{2})-(\d{2})/);
	return match ? new Date(match[0]).getTime() : 0;
}

const photos = Object.entries(assetPhotoModules)
	.map(([path, mod]) => ({
		mod,
		date: extractDateFromPath(path),
	}))
	.sort((a, b) => b.date - a.date);
---

<Layout
  title="Photography"
  description="A selection of my photography."
  fullWidth
>
  <div slot="full">
    <div class="justified-grid three-cols" id="gallery">
      {
        photos.map((p) => (
          <a href={p.mod.default.src} data-fancybox="gallery" class="gallery-item">
            <Image
              src={p.mod.default}
              alt="Photo"
              loading="lazy"
              sizes="(max-width: 1200px) 33vw, 33vw"
            />
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import { Fancybox } from "@fancyapps/ui";

  Fancybox.bind('[data-fancybox="gallery"]', {
    Thumbs: false,
  } as any);
</script>

<style>
  /* SmolCSS-style responsive masonry/justified layout preserving aspect ratios */
  .justified-grid {
    --gap: 0.5rem;
    columns: 3 360px;
    column-gap: var(--gap);
  }

  .gallery-item {
    display: inline-block;
    margin: 0 0 var(--gap);
    width: 100%;
    border: 1px solid #353535;
    background: #111;
  }

  .gallery-item img,
  .gallery-item picture,
  .gallery-item canvas {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .justified-grid {
      columns: 2 280px;
    }
  }
  @media (max-width: 640px) {
    .justified-grid {
      columns: 1 200px;
    }
  }
</style>
