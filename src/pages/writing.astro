---
import "../styles/article-list.css";

import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import PostList from "../components/PostList.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Layout from "../layouts/Layout.astro";

const notes = await getCollection(
	"posts",
	({ data }) => data.type === "note" && (import.meta.env.DEV || !data.draft),
);
---
<Layout
	title="Writing"
	description="Notes on things I've learned."
	pagefindIgnore
>
  <div class="layout-grid-left" slot="left">
    <Card class="flex-col-card">
      <h2 class="no-mt">Stats</h2>
			<div class="stats-div">
				<div class="stat">
					<h3 class="text-glow">{notes.length}</h3>
					<span>Note{notes.length === 1 ? '' : 's'}</span>
				</div>
			</div>
    </Card>
  </div>
  <div class="layout-grid-right" slot="right">
		<Card>
			<SectionHeader icon={{ type: "lucide", name: "notebook-pen" }} title="Latest Writing" />
			<PostList posts={notes} />
		</Card>
  </div>
</Layout>
