---
import { getCollection } from "astro:content";
import { openGraph } from "spectre:globals";
import Card from "../components/Card.astro";
import PostList from "../components/PostList.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection(
	"posts",
	({ data }) => data.type === "project" && (import.meta.env.DEV || !data.draft),
);
---
<Layout
	title={openGraph.projects.title || "Projects"}
	description={openGraph.projects.description}
	pagefindIgnore
>
  <div class="layout-grid-left" slot="left">
    <Card class="flex-col-card">
      <h1 class="no-mt page-title">Projects</h1>
      <h2>Stats</h2>
			<div class="stats-div">
				<div class="stat">
					<h3 class="text-glow">{projects.length}</h3>
					<span>Project{projects.length === 1 ? '' : 's'}</span>
				</div>
			</div>
    </Card>
  </div>
  <div class="layout-grid-right" slot="right">
		<Card>
			<SectionHeader icon={{ type: "lucide", name: "folder-git" }} title="Latest Projects" />
			<PostList posts={projects} />
		</Card>
  </div>
</Layout>
