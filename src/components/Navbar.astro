---
import { name } from "spectre:globals";
import Icon from "./Icon.astro";
import Search from "./Search.astro";

const path = Astro.url.pathname;

const navLinks = [
	{ href: "/projects", label: "Projects" },
	{ href: "/writing", label: "Writing" },
	{ href: "/photography", label: "Photography" },
];
---

<nav>
  <a class="site-title" href="/">
    <img src="/favicon.svg" alt="Logo" class="site-logo" />
    {name}
  </a>
  <ul id="nav-menu">
    {navLinks.map((link) => (
      <>
        <li>
          <a href={link.href} class:list={{ active: path.startsWith(link.href) }}>{link.label}</a>
        </li>
        <li class="nav-separator">/</li>
      </>
    ))}
    <Search />
  </ul>
  <button
    class="mobile-nav-toggle"
    aria-label="Mobile menu trigger"
    aria-expanded="false"
    aria-controls="nav-menu"
  >
    <Icon
      type="lucide"
      name="menu"
      width={24}
      height={24}
      class="menu-closed"
    />
    <Icon type="lucide" name="x" width={24} height={24} class="menu-open" />
  </button>
</nav>
<script>
  const navToggle = document.querySelector<HTMLButtonElement>(".mobile-nav-toggle");
  const nav = document.querySelector("nav");

  navToggle?.addEventListener("click", () => {
    const isOpen = navToggle.classList.toggle("active");
    nav?.classList.toggle("active");
    navToggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    z-index: 50;
  }

  .site-title {
    font-weight: 800;
    text-decoration: none;
    font-size: 1.25em;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-logo {
    width: 1.5em;
    height: 1.5em;
  }

  nav ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style-type: none;
    align-items: center;
  }

  nav ul li {
    position: relative;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    background-color: var(--primary-contrast-bg);
  }

  nav a:focus-visible {
    outline: 2px solid var(--primary-lightest);
    outline-offset: -2px;
  }

  .mobile-nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    background-color: var(--surface-1);
    border: 1px solid var(--border);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
  }

  .menu-open {
    display: none;
  }

  .mobile-nav-toggle.active .menu-open {
    display: flex;
  }

  .mobile-nav-toggle.active .menu-closed {
    display: none;
  }

  @media screen and (max-width: 640px) {
    nav {
      padding: 0 1rem;
      padding-top: 1rem;
      transition: all var(--transition-base);
    }

    .mobile-nav-toggle {
      display: flex;
    }

    .nav-separator {
      display: none;
    }

    nav ul {
      flex-direction: column;
      gap: 0;
      position: absolute;
      width: 100%;
      top: calc(1rem + 40px);
      right: 0;
      padding: 1rem;
      z-index: 1;
      opacity: 0;
      pointer-events: none;
      transition: all var(--transition-base);
      user-select: none;
      height: calc(100vh - 1rem - 40px);
      align-items: start;
    }

    nav.active {
      background-color: var(--surface-2);
    }

    nav.active ul {
      opacity: 1;
      pointer-events: all;
      background-color: var(--surface-2);
    }

    nav ul li {
      position: relative;
      transition: all var(--transition-base);
      top: -1.5rem;
      border-bottom: 1px solid var(--border);
      width: 100%;
      max-width: none;
      padding: 0;
      font-size: 1.125em;
    }

    nav ul li a {
      display: block;
      padding: 0.75rem 0;
      width: 100%;
      padding-left: 1rem;
    }

    nav ul li:first-child {
      border-top: 1px solid var(--border);
    }

    nav.active ul li {
      top: 0;
    }
  }
</style>
